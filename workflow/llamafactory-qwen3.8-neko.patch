 logger = logging.get_logger(__name__)
 
 
+def _dequantize_4bit_lm_head(model: torch.nn.Module) -> None:
+    import bitsandbytes as bnb
+
+    inner = model.get_base_model() if hasattr(model, "get_base_model") else model
+    head = getattr(inner, "lm_head", None)
+    if head is None:
+        return
+    base = getattr(head, "base_layer", head)
+    weight = getattr(base, "weight", None)
+    if not isinstance(weight, bnb.nn.Params4bit):
+        return
+    qs = getattr(weight, "quant_state", None) or getattr(base, "quant_state", None)
+    if qs is None:
+        logger.warning_rank0("lm_head has Params4bit but no quant_state; skip dequant.")
+        return
+    w = bnb.functional.dequantize_4bit(weight.data, qs).to(dtype=torch.bfloat16)
+    new_head = torch.nn.Linear(
+        base.in_features,
+        base.out_features,
+        bias=base.bias is not None,
+        device=w.device,
+        dtype=torch.bfloat16,
+    )
+    with torch.no_grad():
+        new_head.weight.copy_(w)
+        if base.bias is not None:
+            new_head.bias.copy_(base.bias.data.to(torch.bfloat16))
+    new_head.requires_grad_(False)
+    inner.lm_head = new_head
+    del base, weight, w, head
+    torch.cuda.empty_cache()
+    logger.info_rank0("Dequantized inner lm_head from NF4 to bf16.")
+
