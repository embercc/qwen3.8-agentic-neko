         for handle in self._handles:
             handle.remove()
         self._handles.clear()
+
+
+class SkipNonFiniteCallback(TrainerCallback):
+    r"""Skip optimizer.step when grads are NaN/Inf. Stop after too many consecutive skips."""
+
+    def __init__(self, max_consecutive_skips: int = 8) -> None:
+        raw = os.getenv("NEKO_NAN_MAX_SKIP")
+        if raw:
+            max_consecutive_skips = int(raw)
+        self.max_consecutive_skips = max_consecutive_skips
+        self.consecutive = 0
+        self.total_skips = 0
+        self._skip_next = False
+        self._wrapped = False
+
+    @staticmethod
+    def _grads_finite(model: Optional["torch.nn.Module"]) -> bool:
+        if model is None:
+            return True
+        for p in model.parameters():
+            if p.grad is None:
+                continue
+            if not torch.isfinite(p.grad).all():
+                return False
+        return True
+
+    @override
+    def on_train_begin(self, args: "TrainingArguments", state: "TrainerState", control: "TrainerControl", **kwargs):
+        optimizer = kwargs.get("optimizer")
+        if optimizer is None or self._wrapped:
+            return
+        orig_step = optimizer.step
+
+        def step(*args, **kw):
+            if self._skip_next:
+                self._skip_next = False
+                return None
+            return orig_step(*args, **kw)
+
+        optimizer.step = step  # type: ignore[method-assign]
+        self._wrapped = True
+        logger.info_rank0(
+            f"SkipNonFiniteCallback on: skip non-finite grads, stop after {self.max_consecutive_skips} consecutive."
+        )
+
+    @override
+    def on_pre_optimizer_step(
+        self, args: "TrainingArguments", state: "TrainerState", control: "TrainerControl", **kwargs
+    ):
+        model = kwargs.get("model")
+        if self._grads_finite(model):
+            self.consecutive = 0
+            return
+        self._skip_next = True
+        self.consecutive += 1
+        self.total_skips += 1
+        step = state.global_step + 1
+        logger.warning_rank0(
+            f"Non-finite grad at step {step}; skip optimizer.step "
+            f"(consecutive={self.consecutive}, total={self.total_skips})."
+        )
+        if self.consecutive >= self.max_consecutive_skips:
+            logger.warning_rank0("Too many consecutive non-finite grads, stopping.")
+            control.should_training_stop = True
